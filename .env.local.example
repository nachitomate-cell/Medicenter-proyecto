# ── Auditor Clínico — variables de entorno ──────────────────────────
# Copiar a .env.local y completar. NO commitear .env.local.

# Proveedor del LLM auditor: groq (default) | anthropic | openai
AUDITOR_PROVIDER=groq

# Transcripción (Whisper) — siempre requerida.
# También se usa para la auditoría si AUDITOR_PROVIDER=groq.
GROQ_API_KEY=

# Solo si AUDITOR_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Solo si AUDITOR_PROVIDER=openai
OPENAI_API_KEY=

# ── Firebase Admin (Firestore + Storage) ────────────────────────────
# En desarrollo podés usar un service-account.json en la raíz en lugar
# de estas tres variables (ver lib/firebase-admin.ts).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Opcional. Default: <FIREBASE_PROJECT_ID>.appspot.com
FIREBASE_STORAGE_BUCKET=
