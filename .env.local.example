# ── Auditor Clínico — variables de entorno ──────────────────────────
# Copiar a .env.local y completar. NO commitear .env.local.

# Proveedor del LLM auditor: groq (default) | anthropic | openai | gemini
AUDITOR_PROVIDER=groq

# Proveedor de transcripción de audio: groq (default) | gemini
# - groq: Whisper large-v3, devuelve timestamps (marcadores de audio). Recomendado.
# - gemini: transcribe con Gemini usando solo GEMINI_API_KEY (sin timestamps).
TRANSCRIPTION_PROVIDER=groq

# API key de Groq. Requerida si TRANSCRIPTION_PROVIDER=groq (transcripción) y/o
# si AUDITOR_PROVIDER=groq (auditoría). No hace falta si transcribís y auditás
# todo con Gemini.
GROQ_API_KEY=

# Solo si AUDITOR_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Solo si AUDITOR_PROVIDER=openai
OPENAI_API_KEY=

# Solo si AUDITOR_PROVIDER=gemini. API key de Google AI Studio:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo de Gemini. Default: gemini-2.5-flash (barato/rápido para pruebas).
# Para mejor calidad clínica: gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# ── Firebase Admin (Firestore + Storage) ────────────────────────────
# En desarrollo podés usar un service-account.json en la raíz en lugar
# de estas tres variables (ver lib/firebase-admin.ts).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Opcional. Default: <FIREBASE_PROJECT_ID>.appspot.com
FIREBASE_STORAGE_BUCKET=
